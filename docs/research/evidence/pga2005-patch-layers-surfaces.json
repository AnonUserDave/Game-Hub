      "c2": "bounce normal restitution in CBallFlight::Collide 0x101f3310",
      "c3": "bounce tangential friction limit in Collide",
      "c4": "slip phase: tangential gravity multiplied by (1 - c4) in RollingAndSlipping 0x101f6112",
      "c5": "slip phase friction torque coefficient in RollingAndSlipping",
      "c6": "pure-roll side-slope break in PureRolling 0x101f6742",
      "c7": "pure-roll rolling resistance in PureRolling (stop when speed < deceleration)",
      "c8": "impact firmness divisor in Collide (dent/absorption term and restitution fall-off)",
      "c9": "constant dent/absorption term in Collide"
    },
